# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/e2e/.auth

# next.js
/.next/
/out/

# production
/build
/generated

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# E2B template builds
*.tar.gz
e2b-template-*

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Cursor: commit project rules and skills; ignore caches/secrets only
# (.cursor/rules and .cursor/skills are NOT ignored)
.cursor/**/.env
.cursor/**/.env.*
.cursor/**/node_modules/
.cursor/**/*.pem
.cursor/skills/**/cache/
.cursor/**/.sync-manifest.json
.cursor/skills/**/__pycache__/
.cursor/skills/**/*.pyc

# Local object storage (STORAGE_DRIVER=local)
/public/uploads
/tmp/backups

# Temporary files
*.tmp
*.temp
repomix-output.txt
bun.lockb
.env*.local

# Sentry Config File
.env.sentry-build-plugin

# Local DATA_DIR default (config / cache / tmp)
/.data/

# Claude Code — commit shared config and skills; keep personal/local state out.
# (.claude/settings.json and .claude/skills are NOT ignored)
.claude/settings.local.json
.claude/worktrees/
.claude/**/.env
.claude/**/.env.*
.claude/skills/**/__pycache__/
.claude/skills/**/*.pyc

# In-browser preview vendor asset (copied from node_modules/esbuild-wasm at install)
public/preview-vendor/esbuild.wasm

# Local git worktrees for isolated agent workspaces
/.worktrees/
