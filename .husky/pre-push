#!/usr/bin/env sh
# Same rule as pre-commit: no `pnpm run` / `pnpm exec` in a hook, because pnpm's
# dependency-status check can purge node_modules first (.cursor/lessons-learned.md).
# `pnpm run verify` is `tsx scripts/verify.ts`, so call it directly.
#
# The rule only started holding all the way down on 2026-08-19: every step in
# `lib/verify/orchestrator.ts` used to be `pnpm exec ...`, spawned with this hook's
# TTY, so the purge this hook exists to avoid happened one process deeper. The
# steps now name vendored binaries; `pnpm audit` is the single remaining call and
# is not a script runner.
set -e

cd "$(git rev-parse --show-toplevel)"

# Git exports its own context into hooks, and from a linked worktree that is an
# ABSOLUTE GIT_DIR - so every git invocation inside the verify suite, including
# the one tests/setup/repo-write-guard.test.ts runs in a temp dir to prove git
# is unavailable there, resolves back to this repository and the gate fails
# from any worktree. From the primary checkout GIT_DIR is the relative ".git",
# which is why this never bit there.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

tsx="./node_modules/tsx/dist/cli.mjs"

if [ ! -f "$tsx" ]; then
  echo "pre-push: $tsx is missing — run pnpm install (never pnpm exec), then push again." >&2
  exit 1
fi

node "$tsx" scripts/verify.ts
