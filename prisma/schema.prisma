generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectPhase {
  PLANNING
  BUILDING
  COMPLETE
}

enum ProjectPlanStatus {
  PENDING
  APPROVED
  SUPERSEDED
}

enum Stack {
  NEXTJS
  REACT
  STATIC_HTML
}

enum PreviewBuildStatus {
  PENDING
  BUILDING
  READY
  FAILED
}

enum PreviewMode {
  STATIC
}

enum JobKind {
  PLAN
  BUILD
  FOLLOWUP
  IMPORT
  AUDIT
  PUBLISH
  DOMAIN_VERIFY
  EXPORT
  TEMPLATE_THUMBNAIL
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
  CANCELLED
}

/// DATABASE-ONLY INVARIANT (F-309), not expressible in this schema: the trigger
/// `user_prevent_last_admin` (function `prevent_last_admin_removal()`,
/// `20260817270000_audit_invariants/migration.sql`) refuses any UPDATE that would leave
/// zero active ADMIN rows, serialized on an advisory lock. `lib/team/actions.ts` reads its
/// `check_violation` and turns it into the operator-facing refusal — so a schema-first
/// rebuild (`prisma db push`, `migrate reset` from the datamodel) silently loses admin
/// lockout protection. `tests/integration/db-invariants.test.ts` asserts it is present.
model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  name                   String
  passwordHash           String
  role                   Role                 @default(MEMBER)
  isActive               Boolean              @default(true)
  avatarUrl              String?
  emailVerified          DateTime?
  passwordChangedAt      DateTime?
  promptTipsDismissedAt  DateTime?
  productTourCompletedAt DateTime?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  accounts               Account[]
  sessions               Session[]
  projects               Project[]
  apiKeys                ApiKey[]
  invitesSent            Invite[]             @relation("InvitedBy")
  generationEvents       GenerationEvent[]
  stars                  ProjectStar[]
  githubConnection       GitHubConnection?
  skillsCreated          Skill[]
  creditLedgers          CreditLedger[]
  publishedDeployments   Deployment[]
  integrationsConnected  Integration[]
  passwordResetTokens    PasswordResetToken[]
  lockedProjects         Project[]            @relation("ProjectLock")
  projectPresence        ProjectPresence[]
  templatesCreated       Template[]
  jobs                   Job[]
}

/// Auth.js adapter table. NEVER WRITTEN in this product: `auth.ts` wires `PrismaAdapter`, but
/// `session.strategy` is `'jwt'` and `Credentials` is the only provider, so no OAuth account row
/// is ever created. Kept because dropping it would fight the adapter's typings and because a
/// future OAuth provider needs it. Do not read it to answer "which accounts are linked".
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js adapter table. NEVER WRITTEN, for the same reason as `Account`: sessions are JWTs
/// held by the client, so there is no server-side session row and **individual sessions are not
/// revocable**. What actually signs other devices out is `User.passwordChangedAt`, which the
/// `jwt` callback compares against the token's `iat`; `passwordChangeWrites`
/// (lib/auth/session-invalidation.ts) also deletes from here as belt-and-braces for rows left
/// by an earlier strategy. Do not add a feature that assumes this table lists live sessions.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Auth.js adapter table. NEVER WRITTEN: there is no email/magic-link provider. Password
/// resets use `PasswordResetToken` above, and invites use `Invite.tokenHash`.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                     String                   @id @default(cuid())
  name                   String
  initialPrompt          String                   @db.Text
  ownerId                String
  owner                  User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  thumbnailUrl           String?                  @db.Text
  status                 String                   @default("draft")
  generationStatus       String                   @default("idle")
  deletedAt              DateTime?
  style                  String?
  model                  String?
  previewUrl             String?
  lastCode               String?                  @db.Text
  progressMessage        String?                  @db.Text
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// Job is authoritative; phase is a side effect of job transitions — never updated independently.
  phase                  ProjectPhase             @default(PLANNING)
  activeJobId            String?
  activeJob              Job?                     @relation("ProjectActiveJob", fields: [activeJobId], references: [id], onDelete: SetNull)
  jobs                   Job[]                    @relation("ProjectJobs")
  stack                  Stack                    @default(NEXTJS)
  designDirection        String                   @default("minimal")
  githubRepoFullName     String?
  githubRepoUrl          String?
  lastPushedAt           DateTime?
  generationEvents       GenerationEvent[]
  plans                  ProjectPlan[]
  stars                  ProjectStar[]
  checkpoints            Checkpoint[]
  projectAssets          ProjectAsset[]
  seoAudits              SeoAudit[]
  codeAudits             CodeAudit[]
  qualitySignals         QualitySignal[]
  importSource           ImportSource?
  memories               MemoryEntry[]
  deployments            Deployment[]
  lockedById             String?
  lockedBy               User?                    @relation("ProjectLock", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt               DateTime?
  lockExpiresAt          DateTime?
  lockReason             String?
  contentVersion         Int                      @default(0)
  presence               ProjectPresence[]
  activePreviewBuildId   String?
  previewMode            PreviewMode              @default(STATIC)
  /// F-102: which checkpoint the workspace is *viewing*. A preview is a read — it never
  /// writes `lastCode` — so this column is the only record that the pane is showing an
  /// older version, and the only thing that survives a reload. NULL means "current".
  previewingCheckpointId String?
  /// Whether the files now in `lastCode` passed the build validators. Written in the same
  /// guarded statement as `lastCode` itself, so it always describes the current site rather
  /// than some earlier one. NULL means never checked, which is every row that predates the
  /// column and every write that is not a generation.
  lastCodeValidated      Boolean?
  previewBuilds          PreviewBuild[]
  /// Generated tsvector (name + initialPrompt). Unmapped; queried via raw SQL only.
  searchVector           Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(\"initialPrompt\", ''::text)), 'B'::\"char\"))"))

  @@index([ownerId])
  @@index([deletedAt])
  /// F-314: listProjects filters deletedAt and orders by updatedAt desc.
  @@index([deletedAt, updatedAt])
  @@index([lockedById, lockExpiresAt])
  @@index([searchVector], type: Gin, map: "Project_searchVector_idx")
}

model PreviewBuild {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpointId  String
  status        PreviewBuildStatus @default(PENDING)
  mode          PreviewMode
  storagePrefix String?
  entryPath     String             @default("index.html")
  isSpa         Boolean            @default(false)
  fileCount     Int                @default(0)
  totalBytes    Int                @default(0)
  buildLog      String?            @db.Text
  error         String?
  builtAt       DateTime?
  createdAt     DateTime           @default(now())

  @@index([projectId, createdAt])
}

model ProjectPresence {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId, lastSeenAt])
}

model ImportSource {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUrl    String
  mode         String
  designTokens Json
  sections     Json
  capturedAt   DateTime
}

model ProjectAsset {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  kind       String
  prompt     String?
  altText    String
  width      Int
  height     Int
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model SeoAudit {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings  Json
  scannedAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, scannedAt])
}

model CodeAudit {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings  Json
  metrics   Json
  scannedAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, scannedAt])
}

model Checkpoint {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label             String
  sourceMessage     String?  @db.Text
  trigger           String
  /// Legacy inline snapshot. New rows leave this null; read via readSnapshot only.
  fileSnapshot      Json?
  snapshotKey       String?
  snapshotBytes     Int?
  snapshotFileCount Int?
  isBookmarked      Boolean  @default(false)
  snapshotPruned    Boolean  @default(false)
  /// What the validators said about *these* files when they were generated: true passed,
  /// false failed, NULL never asked (every pre-existing row, a URL import, a restore).
  /// NULL is not "good" — it is "no evidence", and the read path treats it that way.
  snapshotValidated Boolean?
  thumbnailUrl      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  /// F-314: the export route reads one project's unpruned history newest-first.
  @@index([projectId, createdAt])
  @@index([isBookmarked, snapshotPruned, createdAt])
  /// The held-back read looks for one row: this project's newest snapshot proven good.
  @@index([projectId, snapshotValidated, createdAt])
}

/// Single-row workspace storage ledger (id = "default").
/// Updated on snapshot write/prune/purge and image store/remove.
/// Plan + credits live on the same row so storageBytes is never dropped.
/// Alternative considered: AppSetting keys workspace.storageBytes / workspace.storageLimitBytes.
model Workspace {
  id                      String         @id
  storageBytes            Int            @default(0)
  storageLimitBytes       Int?
  planId                  String?
  plan                    Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  creditsUsed             Int            @default(0)
  creditsPeriodStart      DateTime       @default(now())
  memberMonthlyCreditCap  Int?
  generationPaused        Boolean        @default(false)
  pauseReason             String?
  creditAlert80Sent       Boolean        @default(false)
  monthlySpendLimitUsd    Decimal?       @db.Decimal(12, 4)
  spendUsd                Decimal        @default(0) @db.Decimal(12, 4)
  spendAlert80Sent        Boolean        @default(false)
  githubOrgInstallationId String?
  creditLedgers           CreditLedger[]
  deployments             Deployment[]
  integrations            Integration[]
  customDomains           CustomDomain[]
  templates               Template[]
  jobs                    Job[]
}

model Plan {
  id                      String      @id @default(cuid())
  key                     String      @unique
  name                    String
  isActive                Boolean     @default(true)
  isDefault               Boolean     @default(false)
  monthlyCredits          Int
  maxProjects             Int
  maxLiveSites            Int
  maxPreviewSites         Int
  maxMembers              Int
  checkpointRetentionDays Int
  storageBytesLimit       BigInt
  allowCustomDomain       Boolean     @default(false)
  allowGithubSync         Boolean     @default(false)
  maxTokensPerJob         Int         @default(120000)
  maxFilesPerJob          Int         @default(60)
  maxOutputBytesPerJob    Int         @default(2000000)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  workspaces              Workspace[]
}

model CreditLedger {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Deliberately unconstrained: billing history outlives the project it was spent on, so
  /// there is no relation and no cascade. Indexed (F-363) so attribution is not a scan.
  projectId   String?
  action      String
  credits     Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@index([projectId])
}

model ProjectStar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectPlan {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  content       Json
  status        ProjectPlanStatus @default(PENDING)
  sourceMessage String            @db.Text
  trigger       String
  createdAt     DateTime          @default(now())

  @@index([projectId])
}

/// Invite history, and — as of F-351 — a live single-use invitation.
///
/// `POST /api/admin/invite` writes a *pending* row (`acceptedAt` null, `tokenHash` set,
/// `expiresAt` in the future) and mails the link; the invitee redeems it at `/accept-invite`,
/// which POSTs `/api/auth/accept-invite` -> `acceptInviteWithToken` (lib/invites/service.ts).
/// That claim is a conditional UPDATE, which is what makes the link single-use with two tabs
/// open. Re-inviting the same address rotates the token and revokes the old one
/// (`revokedAt`). No password is ever returned to the admin, and the raw token is never
/// stored — only its sha256. Behaviour is pinned in tests/integration/invite-acceptance.test.ts.
model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MEMBER)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  /// SHA-256 of the single-use invite token. The token itself is never stored.
  tokenHash   String?   @unique
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([email])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  last4     String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model OrgApiKey {
  id        String   @id @default(cuid())
  provider  String   @unique
  last4     String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitHubConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId         String
  githubUsername       String
  accessTokenEncrypted String    @db.Text
  scope                String
  connectedAt          DateTime  @default(now())
  /// F-206: the last time *this member's* personal token was rejected. A per-user grant
  /// failing says nothing about the workspace GitHub App, so it is recorded here rather
  /// than on the `GITHUB_DEPLOY` Integration row that gates publishing for everyone.
  /// Read only when `lastErrorAt > connectedAt`, so a reconnect retires it with no write.
  lastError            String?   @db.Text
  lastErrorAt          DateTime?
}

// Workspace-scoped conditional instruction sets. Project Brain memory is a separate concern.
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  content     String   @db.Text
  enabled     Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([usageCount])
}

model MemoryEntry {
  id          String   @id @default(cuid())
  scope       String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  content     String
  source      String
  status      String   @default("ACTIVE")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, projectId, status])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GenerationEvent {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  estimatedCost Decimal  @db.Decimal(10, 4)
  inputTokens   Int?
  promptVersion String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model QualitySignal {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationEventId String?
  kind              String
  value             Float
  rawValue          Json?
  promptVersion     String
  createdAt         DateTime @default(now())

  @@index([kind, createdAt])
  @@index([promptVersion])
  @@index([projectId])
}

model PromptVersion {
  id        String   @id @default(cuid())
  hash      String   @unique
  label     String
  config    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isActive])
}

enum IntegrationKind {
  GITHUB_DEPLOY
  CLOUDFLARE
  COOLIFY
  SENTRY
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

model Integration {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind          IntegrationKind
  status        IntegrationStatus @default(DISCONNECTED)
  config        Json
  secrets       String?           @db.Text
  lastCheckedAt DateTime?
  lastError     String?
  connectedById String?
  connectedBy   User?             @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([workspaceId, kind])
  @@index([workspaceId, status])
}

enum DeploymentKind {
  PREVIEW
  LIVE
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  LIVE
  FAILED
  STOPPED
}

model CoolifyServer {
  id             String       @id @default(cuid())
  name           String
  apiUrl         String
  apiToken       String
  serverIp       String
  projectUuid    String
  isActive       Boolean      @default(true)
  maxDeployments Int          @default(50)
  createdAt      DateTime     @default(now())
  deployments    Deployment[]
}

/// DATABASE-ONLY INVARIANT (F-309), not expressible in this schema: the expression unique
/// index `Deployment_dns_label_key` on
/// `(CASE WHEN kind = 'PREVIEW' THEN 'preview-' || slug ELSE slug END)` stops a LIVE slug
/// `preview-acme` colliding with the DNS label a PREVIEW deploy of `acme` gets. Prisma
/// models neither expression nor partial indexes. `tests/integration/db-invariants.test.ts`
/// asserts it is present. `onDelete: Restrict` below is the third invariant and IS in this
/// schema — hard-deleting a project with a deployment must go through purge, which releases
/// the external Coolify and DNS resources first.
model Deployment {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serverId       String
  server         CoolifyServer    @relation(fields: [serverId], references: [id], onDelete: Restrict)
  kind           DeploymentKind
  status         DeploymentStatus
  slug           String
  url            String?
  repoFullName   String?
  repoBranch     String           @default("main")
  commitSha      String?
  // Immutable GitHub repo id recorded when publish creates the deploy repo (F-202):
  // the guard refuses to push to a same-named repo whose id does not match.
  githubRepoId   String?
  coolifyAppUuid String?
  dnsRecordId    String?
  passwordHash   String?
  lastError      String?
  lastRequestId  String?
  buildLogUrl    String?
  progressStep   String?
  publishedById  String
  publishedBy    User             @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customDomains  CustomDomain[]

  @@unique([projectId, kind])
  @@unique([slug, kind])
  @@index([workspaceId, status])
}

enum CustomDomainStatus {
  PENDING_DNS
  VERIFYING
  SSL_PENDING
  ACTIVE
  FAILED
}

enum CustomDomainPath {
  A
  B
}

model CustomDomain {
  id               String             @id @default(cuid())
  deploymentId     String
  deployment       Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostname         String             @unique
  status           CustomDomainStatus @default(PENDING_DNS)
  verifyToken      String
  expectedTarget   String
  lastCheckedAt    DateTime?
  lastError        String?
  sslIssuedAt      DateTime?
  isPrimary        Boolean            @default(false)
  path             CustomDomainPath   @default(A)
  cloudflareZoneId String?
  nameservers      Json?
  createdAt        DateTime           @default(now())

  @@index([status, lastCheckedAt])
  @@index([deploymentId])
  @@index([workspaceId])
}

/// Starting prompts the agency reuses. workspaceId null = built-in / shared.
model Template {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String
  category        String
  stack           Stack
  prompt          String     @db.Text
  designDirection String?
  thumbnailKey    String?
  previewUrl      String?
  isActive        Boolean    @default(true)
  isBuiltIn       Boolean    @default(false)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  usageCount      Int        @default(0)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())

  @@index([category, isActive])
}

/// DB dump, storage verify, and restore-test attempts (including failures).
model BackupRun {
  id         String    @id @default(cuid())
  kind       String
  status     String
  objectKey  String?
  sizeBytes  BigInt?
  durationMs Int?
  detail     String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([kind, startedAt])
}

/// Durable long-running work. Table stays GenerationJob (@@map) so existing rows are kept.
/// Phase on Project is a side effect of these rows.
///
/// DATABASE-ONLY INVARIANTS (F-309), not expressible in this schema — Prisma models no
/// partial indexes, so the `@@index` list below names only two of the four objects that
/// exist on this table (`20260817220000_generation_jobs/migration.sql`):
///   1. `one_active_job_per_project` — UNIQUE ("projectId") WHERE status IN ('QUEUED','RUNNING').
///      The whole job state machine and `createOrReuseJob` rest on it; without it two
///      concurrent generations for one project both run and both charge.
///   2. `generation_job_project_idempotency_key` — UNIQUE ("projectId","idempotencyKey")
///      WHERE "idempotencyKey" IS NOT NULL. Without it `idempotencyKey` below is an
///      unenforced column and a retried submit is charged twice.
/// `tests/integration/db-invariants.test.ts` asserts both are present.
model Job {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation("ProjectJobs", fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        JobKind
  status      JobStatus @default(QUEUED)

  ownerInstance String?
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?

  attempt     Int @default(1)
  maxAttempts Int @default(2)

  inputPrompt      String?  @db.Text
  planVersion      Int?
  partialFiles     Json?
  filesWritten     Int      @default(0)
  lastStep         String?
  tokensIn         Int?
  tokensOut        Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  provider         String?
  model            String?
  queuePosition    Int?

  errorCode        String?
  errorMessage     String?   @db.Text
  requestId        String?
  idempotencyKey   String?
  creditsChargedAt DateTime?
  steps            Json?
  currentStep      String?
  resourceIds      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  activeFor Project[] @relation("ProjectActiveJob")

  @@index([projectId, createdAt])
  @@index([status, heartbeatAt])
  @@map("GenerationJob")
}

/// Durable admin/security trail. Distinct from CodeAudit (SEO/code quality).
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  actorEmail  String
  action      String
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  requestId   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
}

/// Local heartbeat / quota / DSN self-checks. Distinct from Sentry going silent.
model ObservabilityCheck {
  id        String   @id @default(cuid())
  kind      String
  ok        Boolean
  detail    String?
  eventId   String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Every cron endpoint writes a row on success or failure.
model CronRun {
  id         String   @id @default(cuid())
  name       String
  ok         Boolean
  durationMs Int?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
}
