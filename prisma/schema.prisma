generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectPhase {
  PLANNING
  BUILDING
  COMPLETE
}

enum ProjectPlanStatus {
  PENDING
  APPROVED
  SUPERSEDED
}

enum Stack {
  NEXTJS
  REACT
  ASTRO
  STATIC_HTML
  VUE
  SVELTE
}

enum SandboxStatus {
  NONE
  BOOTING
  READY
  DEAD
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(MEMBER)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  apiKeys          ApiKey[]
  invitesSent      Invite[]  @relation("InvitedBy")
  generationEvents GenerationEvent[]
  stars            ProjectStar[]
  githubConnection GitHubConnection?
  skillsCreated    Skill[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id               String    @id @default(cuid())
  name             String
  initialPrompt    String    @db.Text
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  thumbnailUrl     String?   @db.Text
  status           String    @default("draft")
  generationStatus String    @default("idle")
  deletedAt        DateTime?
  style            String?
  model            String?
  sandboxId          String?
  previewUrl         String?
  sandboxStatus      SandboxStatus @default(NONE)
  sandboxStartedAt   DateTime?
  sandboxLastUsedAt  DateTime?
  lastCode         String?   @db.Text
  progressMessage  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  phase            ProjectPhase @default(PLANNING)
  stack            Stack        @default(NEXTJS)
  designDirection  String       @default("minimal")
  githubRepoFullName String?
  githubRepoUrl      String?
  lastPushedAt       DateTime?
  generationEvents GenerationEvent[]
  plans            ProjectPlan[]
  stars            ProjectStar[]
  checkpoints      Checkpoint[]
  projectAssets    ProjectAsset[]
  seoAudits        SeoAudit[]
  codeAudits       CodeAudit[]
  qualitySignals   QualitySignal[]
  importSource     ImportSource?
  memories         MemoryEntry[]

  @@index([ownerId])
  @@index([deletedAt])
  @@index([sandboxStatus, sandboxLastUsedAt])
}

model ImportSource {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUrl    String
  mode         String
  designTokens Json
  sections     Json
  capturedAt   DateTime
}

model ProjectAsset {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  kind       String
  prompt     String?
  altText    String
  width      Int
  height     Int
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model SeoAudit {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings  Json
  scannedAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, scannedAt])
}

model CodeAudit {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings  Json
  metrics   Json
  scannedAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, scannedAt])
}

model Checkpoint {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label             String
  sourceMessage     String?  @db.Text
  trigger           String
  /// Legacy inline snapshot. New rows leave this null; read via readSnapshot only.
  fileSnapshot      Json?
  snapshotKey       String?
  snapshotBytes     Int?
  snapshotFileCount Int?
  isBookmarked      Boolean  @default(false)
  snapshotPruned    Boolean  @default(false)
  thumbnailUrl      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@index([isBookmarked, snapshotPruned, createdAt])
}

/// Single-row workspace storage ledger (id = "default").
/// Updated on snapshot write/prune/purge and image store/remove.
/// Alternative considered: AppSetting keys workspace.storageBytes / workspace.storageLimitBytes.
model Workspace {
  id                String @id
  storageBytes      Int    @default(0)
  storageLimitBytes Int?
}

model ProjectStar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectPlan {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  content       Json
  status        ProjectPlanStatus @default(PENDING)
  sourceMessage String            @db.Text
  trigger       String
  createdAt     DateTime          @default(now())

  @@index([projectId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MEMBER)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([email])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  last4     String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model OrgApiKey {
  id        String   @id @default(cuid())
  provider  String   @unique
  last4     String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitHubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId         String
  githubUsername       String
  accessTokenEncrypted String   @db.Text
  scope                String
  connectedAt          DateTime @default(now())
}

// Workspace-scoped conditional instruction sets. Project Brain memory is a separate concern.
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  content     String   @db.Text
  enabled     Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([usageCount])
}

model MemoryEntry {
  id          String   @id @default(cuid())
  scope       String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  content     String
  source      String
  status      String   @default("ACTIVE")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, projectId, status])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GenerationEvent {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  estimatedCost Decimal  @db.Decimal(10, 4)
  inputTokens   Int?
  promptVersion String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model QualitySignal {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationEventId String?
  kind              String
  value             Float
  rawValue          Json?
  promptVersion     String
  createdAt         DateTime @default(now())

  @@index([kind, createdAt])
  @@index([promptVersion])
  @@index([projectId])
}

model PromptVersion {
  id        String   @id @default(cuid())
  hash      String   @unique
  label     String
  config    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isActive])
}
