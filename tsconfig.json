{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "types/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    // Next's writeConfigurationDefaults re-adds these two globs on every `next dev`/`next build`,
    // so removing them is churn. They are inert: the ".next" entry in `exclude` below filters
    // them back out, and that is deliberate — including .next/**/*.ts broke `tsc --noEmit` twice
    // (see .cursor/lessons-learned.md). Do not remove ".next" from `exclude`.
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "tests",
    "lib/e2b-backends/archive",
    "styles",
    ".next",
    "next-env.d.ts"
  ]
}
