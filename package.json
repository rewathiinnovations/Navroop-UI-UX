{
  "name": "open-lovable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "node scripts/copy-preview-vendor.mjs && next dev",
    "build": "node scripts/copy-preview-vendor.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --project=critical",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "verify": "tsx scripts/verify.ts",
    "verify:full": "tsx scripts/verify.ts --full",
    "verify:bypass": "tsx scripts/verify-bypass.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:test": "tsx scripts/ensure-test-db.ts && tsx scripts/migrate-test-db.ts",
    "db:test:migrate": "tsx scripts/migrate-test-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "smoke": "tsx scripts/smoke-test.ts",
    "rollback": "tsx scripts/rollback.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.4",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@daytona/sdk": "0.205.0",
    "@e2b/code-interpreter": "^2.0.0",
    "@mendable/firecrawl-js": "^4.3.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.70.0",
    "@tabler/icons-react": "^3.34.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^5.0.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "esbuild": "0.25.5",
    "esbuild-wasm": "0.25.5",
    "framer-motion": "^12.23.12",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.8",
    "jotai": "^2.14.0",
    "lighthouse": "^13.4.1",
    "lodash-es": "^4.17.24",
    "lucide-react": "^0.532.0",
    "modal": "0.9.0",
    "motion": "^12.23.12",
    "nanoid": "^5.1.16",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pixi.js": "^8.13.1",
    "playwright": "^1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-syntax-highlighter": "^15.6.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.3.0",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "lint-staged": "^16.1.2",
    "minimatch": "^10.2.2",
    "msw": "^2.10.4",
    "postcss": "^8.5.18",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "semver": "^7.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
