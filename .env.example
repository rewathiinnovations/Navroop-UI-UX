# =================================================================================
# COOLIFY (docker-compose.yml) — set these in the Coolify service env
# =================================================================================
# Required
POSTGRES_PASSWORD=change_me_long_random
DATABASE_URL=postgresql://navroop:change_me_long_random@postgres:5432/navroop
AUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=https://your-coolify-fqdn
# Optional Coolify aliases / extras
# NEXTAUTH_SECRET=
# AUTH_URL=
# POSTGRES_USER=navroop
# POSTGRES_DB=navroop
# PORT=3000

# Required (local scrape)
FIRECRAWL_API_KEY=your_firecrawl_api_key  # Get from https://firecrawl.dev (Web scraping)

# =================================================================================
# SANDBOX PROVIDER - Choose Option 1 OR 2
# =================================================================================

# Option 1: Vercel Sandbox (recommended - default)
# Set SANDBOX_PROVIDER=vercel and choose authentication method below
SANDBOX_PROVIDER=vercel

# Vercel Authentication - Choose method a OR b
# Method a: OIDC Token (recommended for development)
# Run `vercel link` then `vercel env pull` to get VERCEL_OIDC_TOKEN automatically
VERCEL_OIDC_TOKEN=auto_generated_by_vercel_env_pull

# Method b: Personal Access Token (for production or when OIDC unavailable)
# VERCEL_TEAM_ID=team_xxxxxxxxx      # Your Vercel team ID 
# VERCEL_PROJECT_ID=prj_xxxxxxxxx    # Your Vercel project ID
# VERCEL_TOKEN=vercel_xxxxxxxxxxxx   # Personal access token from Vercel dashboard

# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

=======
# Option 2: E2B Sandbox
# Set SANDBOX_PROVIDER=e2b and configure E2B_API_KEY below
# SANDBOX_PROVIDER=e2b
# E2B_API_KEY=your_e2b_api_key  # Get from https://e2b.dev

# =================================================================================
# AI PROVIDERS - Need at least one
# =================================================================================

# Vercel AI Gateway (recommended - provides access to multiple models)
AI_GATEWAY_API_KEY=your_ai_gateway_api_key  # Get from https://vercel.com/dashboard/ai-gateway/api-keys

# Individual provider keys (used when AI_GATEWAY_API_KEY is not set)
ANTHROPIC_API_KEY=your_anthropic_api_key  # Get from https://console.anthropic.com
OPENAI_API_KEY=your_openai_api_key  # Get from https://platform.openai.com (GPT-5)
GEMINI_API_KEY=your_gemini_api_key  # Get from https://aistudio.google.com/app/apikey
GROQ_API_KEY=your_groq_api_key  # Get from https://console.groq.com (Fast inference - Kimi K2 recommended)

# Optional Morph Fast Apply
# Get yours at https://morphllm.com/
MORPH_API_KEY=your_fast_apply_key

# =================================================================================
# AUTH + DATABASE
# =================================================================================
DATABASE_URL=postgresql://openlovable:openlovable@127.0.0.1:5433/openlovable
AUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_NAME=Navroop

# Seed exactly one ADMIN (prisma/seed.mjs). SEED_ADMIN_* is preferred; ADMIN_* is also accepted.
SEED_ADMIN_EMAIL=admin@navroop.local
SEED_ADMIN_PASSWORD=ChangeMeNow123
ADMIN_EMAIL=admin@navroop.local
ADMIN_PASSWORD=ChangeMeNow123

# Local /login quick-login buttons. Ignored when NODE_ENV=production.
# next dev already enables them; set this only if you need the buttons outside development.
# NEXT_PUBLIC_DEV_QUICK_LOGIN=true

# GitHub OAuth account-linking (not login). Register the callback URL on the GitHub OAuth App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/callback

# =================================================================================
# IMAGE STORAGE + STOCK
# =================================================================================
# local (default): writes to /public/uploads and returns a relative URL.
# s3: any S3-compatible endpoint. R2 is recommended (zero egress). Bucket must allow public reads.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=navroop-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://assets.example.com
# S3_REGION=auto

# Unsplash (stock photos). Free-tier access key is enough.
UNSPLASH_ACCESS_KEY=

# =================================================================================
# COOLIFY API (local / admin deploy settings)
# =================================================================================
# Token also stored encrypted in AppSetting. Env wins over the saved secret.
COOLIFY_BASE_URL=https://coolify.navroop.app
COOLIFY_API_TOKEN=

# =================================================================================
# CRON (Coolify scheduled tasks — Bearer CRON_SECRET)
# =================================================================================
# POST /api/cron/reap-sandboxes (every 10 min)
# POST /api/cron/thin-checkpoints (daily)
# POST /api/cron/purge-projects (daily)
CRON_SECRET=replace_with_a_long_random_string
# SANDBOX_IDLE_MINUTES=30
# CHECKPOINT_RETENTION_DAYS=7
# PURGE_DELETED_DAYS=30
