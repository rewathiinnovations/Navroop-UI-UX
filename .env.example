# =================================================================================
# COOLIFY (docker-compose.yml) — set these in the Coolify service env
# =================================================================================
# Required
POSTGRES_PASSWORD=change_me_long_random
DATABASE_URL=postgresql://navroop:change_me_long_random@postgres:5432/navroop
AUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=https://your-coolify-fqdn
# Optional Coolify aliases / extras
# NEXTAUTH_SECRET=
# AUTH_URL=
# POSTGRES_USER=navroop
# POSTGRES_DB=navroop
# PORT=3000

# Required (local scrape)
FIRECRAWL_API_KEY=your_firecrawl_api_key  # Get from https://firecrawl.dev (Web scraping)

# =================================================================================
# AI — optional here; Admin → Configuration is the primary control
# =================================================================================
# Generation runs on DeepSeek and on nothing else (lib/ai/providers.ts). The key is normally
# set in Admin → Configuration, which overrides this file; the variable below is the fallback
# an untouched deployment reads (`ai.deepseek.apiKey` in lib/settings/registry.ts). With a key
# from neither source, planning and building fail with "DeepSeek is not configured".
#
# This block used to advertise "AI PROVIDERS - Need at least one" over AI_GATEWAY_API_KEY,
# ANTHROPIC_API_KEY, GROQ_API_KEY and an AI_PRIMARY_PROVIDER / AI_FALLBACK_* chain. Nothing
# read any of them, and DEEPSEEK_API_KEY — the one key generation actually needs — was absent,
# so an operator could fill this file in completely and still get "No AI provider is
# configured" on the first project (F-712).
#
# Runtime — restart to apply.
DEEPSEEK_API_KEY=
# Leave blank unless DeepSeek traffic is routed through a proxy or gateway.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Which DeepSeek model writes plans and code: deepseek-v4-flash or deepseek-v4-pro.
# AI_PRIMARY_MODEL=deepseek-v4-flash
# How many generations may run at once. Raise it only if the DeepSeek quota allows.
# AI_PROVIDER_CONCURRENCY=2

# Image generation and alt text only (lib/assets/generate-image.ts): OpenAI is tried first,
# then Gemini, and with neither set image generation reports that no provider is configured.
# These are NOT generation providers — they cannot stand in for DEEPSEEK_API_KEY.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# =================================================================================
# AUTH + DATABASE
# =================================================================================
DATABASE_URL=postgresql://openlovable:openlovable@127.0.0.1:5433/openlovable
# Must be a different database name than DATABASE_URL. Same Postgres on 5433 is fine.
TEST_DATABASE_URL=postgresql://openlovable:openlovable@127.0.0.1:5433/openlovable_test
# Optional. Disposable DB for `prisma migrate diff --from-migrations` (verify schema-drift).
# Prisma may drop/recreate it. Must not be DATABASE_URL or TEST_DATABASE_URL.
# If unset, verify derives the same host/user as TEST_DATABASE_URL with database openlovable_shadow.
SHADOW_DATABASE_URL=postgresql://openlovable:openlovable@127.0.0.1:5433/openlovable_shadow
AUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_NAME=Navroop

# Seed exactly one ADMIN (prisma/seed.ts). SEED_ADMIN_* is preferred; ADMIN_* is also accepted.
SEED_ADMIN_EMAIL=admin@navroop.local
SEED_ADMIN_PASSWORD=ChangeMeNow123
ADMIN_EMAIL=admin@navroop.local
ADMIN_PASSWORD=ChangeMeNow123
# Optional. The demo member (member@navroop.local, committed password) is seeded only when
# NODE_ENV != production; a production operator must opt in explicitly. Runtime for the
# seed process only — do not set in Coolify.
# SEED_DEMO_MEMBER=1
# Optional. Runtime — restart to apply. Default on: the documented deployment fronts the app
# with Coolify/Traefik, so the login/forgot-password rate limiters key on the LAST
# x-forwarded-for hop (the address the proxy appended). Set to 0 when the Node process is
# exposed directly; the limiters then ignore proxy headers and key on email alone.
# TRUST_PROXY_HEADERS=1

# Local /login quick-login buttons. Ignored when NODE_ENV=production.
# next dev already enables them; set this only if you need the buttons outside development.
# NEXT_PUBLIC_DEV_QUICK_LOGIN=true

# App origin for GitHub App Manifest redirects and password-reset links. ENCRYPTION_KEY encrypts Integration secrets.
# ENCRYPTION_KEY must be at least 32 bytes. Store it in a password manager off-server.
APP_URL=http://localhost:3000
ENCRYPTION_KEY=
# Public origin of this app. The GitHub App Manifest callback and static preview
# origins are built from it, so the host must match APP_URL. Required in
# production — the app refuses to boot if it is unset, unparseable, or mismatched.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Coolify application UUID for the main Navroop app (rollback). Not a client site.
# COOLIFY_APP_UUID=
# GIT_SHA=
# DEPLOYED_AT=

# Transactional email (password reset). Empty RESEND_API_KEY logs the full email to the console.
RESEND_API_KEY=
EMAIL_FROM=

# GitHub OAuth account-linking (not login). Register the callback URL on the GitHub OAuth App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/callback

# Publish integrations (GitHub App, Cloudflare, Coolify) are configured in /admin/integrations.
# Do not set GITHUB_APP_*, CLOUDFLARE_*, ROOT_DOMAIN, or COOLIFY_API_TOKEN.

# =================================================================================
# IMAGE STORAGE + STOCK
# =================================================================================
# local (default): writes to /public/uploads and returns a relative URL.
# s3: ElasticLake (path-style). Bucket must allow public reads.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=
# STORAGE_DRIVER=s3
# ELK_ENDPOINT=https://s3.example.com
# ELK_REGION=us-east-1
# ELK_ACCESS_KEY_ID=
# ELK_SECRET_ACCESS_KEY=
# ELK_BUCKET=navroop-assets
# S3_PUBLIC_URL=https://assets.example.com

# Separate backup bucket (must differ from ELK_BUCKET). Write+list only recommended.
# BACKUP_ENDPOINT=https://s3.example.com
# BACKUP_REGION=us-east-1
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_BUCKET=navroop-backups
# RESTORE_DATABASE_URL=postgresql://navroop:change_me@127.0.0.1:5433/navroop_restore
# Required only when a pending migration drops a table/column or changes a column type.
# ALLOW_DESTRUCTIVE_MIGRATION=true

# Unsplash (stock photos). Free-tier access key is enough.
UNSPLASH_ACCESS_KEY=

# =================================================================================
# CRON (Coolify scheduled tasks — Bearer CRON_SECRET)
# =================================================================================
# POST /api/cron/check-domains (every 2 min)
# POST /api/cron/reap-jobs (every minute)
# POST /api/cron/thin-checkpoints (daily)
# POST /api/cron/purge-projects (daily)
# POST /api/cron/check-integrations (daily)
# POST /api/cron/cleanup-orphans (daily)
# POST /api/cron/backup-db (daily 02:00)
# POST /api/cron/verify-storage (weekly)
# POST /api/cron/observability-heartbeat (hourly)
# POST /api/cron/observability-quota (daily)
# POST /api/cron/check-uptime (every 10 min)
# POST /api/cron/check-certs (daily)
# POST /api/cron/system-checks-digest (daily)
# POST /api/cron/sweep-tmp (hourly)
# Required for the crons to run at all. authorizeCron fails closed: when this is
# unset every cron request is 401, so the schedules simply never fire.
CRON_SECRET=replace_with_a_long_random_string
# CHECKPOINT_RETENTION_DAYS=7
# PURGE_DELETED_DAYS=30

# =================================================================================
# PERSISTENT VOLUME (cache + bootstrap only — reconstructible)
# =================================================================================
# Coolify: mount a volume at /data. The image chowns it to uid 1001 (nextjs).
# Not in the DB backup. Safe to delete: next boot rebuilds from Postgres / object storage.
# DATA_DIR=/data
# OBSERVABILITY_CONFIG_PATH=/data/config/observability.json
# First boot only: if no Sentry Integration exists, a legacy SENTRY_DSN env value
# creates "Sentry (migrated)" and is then ignored.
